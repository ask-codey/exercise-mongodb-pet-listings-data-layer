# Copy this file to a new file named .env (the lesson "Connecting from Node: MongoClient and the Connection String"
# shows why). npm start reads it, and .gitignore keeps .env out of Git.
# This is MongoDB on your own computer. If you use Atlas, put its connection string here instead, with your
# database user's password where <password> is.
MONGODB_URI=mongodb://localhost:27017
